{
  "name": "authorization-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "GPL-3.0",
  "engineStrict": true,
  "engines": {
    "node": "24",
    "npm": "please-use-yarn",
    "pnpm": "please-use-yarn"
  },
  "scripts": {
    "clean": "rimraf dist node_modules",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:docker": "yarn build:docker:stage:build && yarn build:docker:stage:dependencies-prod && docker build . -t did-auth-proxy-auth-server",
    "build:docker:stage:build": "docker build . --target build -t authorization-service-stage-build",
    "build:docker:stage:dependencies-prod": "docker build . --target dependencies-prod -t authorization-service-stage-dependencies-prod",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "yarn lint --fix",
    "test": "yarn test:unit && yarn test:e2e",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest",
    "test:e2e": "cd test && jest --config ./jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "axios": "^1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "didkit-wasm-node": "0.1.6",
    "ethers": "5.8.0",
    "express": "5.2.1",
    "ioredis": "5.4.1",
    "joi": "17.13.8",
    "jsonwebtoken": "9.0.2",
    "nestjs-pino": "4.6.1",
    "passport": "0.7.0",
    "passport-did-auth": "2.1.0-dev.1328.0",
    "passport-jwt": "4.0.1",
    "pino-http": "10.5.0",
    "pino-pretty": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "siwe": "2.3.2",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@energyweb/eslint-config": "0.1.0",
    "@energyweb/prettier-config": "0.0.1",
    "@golevelup/ts-jest": "0.5.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.12",
    "@types/joi": "17.2.3",
    "@types/node": "24.19.1",
    "@types/passport-jwt": "3.0.13",
    "@types/passport-local": "1.0.38",
    "@types/set-cookie-parser": "2.4.10",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "node-mocks-http": "1.18.1",
    "prettier": "3.3.2",
    "redis-memory-server": "0.17.1",
    "rimraf": "5.0.9",
    "set-cookie-parser": "2.6.0",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-jest": "29.2.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.5.3",
    "webpack": "5.106.2"
  },
  "resolutions": {
    "elliptic": "^6.6.1",
    "passport-did-auth/ethers": "5.8.0",
    "**/@energyweb/ekc/ethers": "5.8.0",
    "**/@ethersproject/providers/ws": "^8.21.0",
    "**/@walletconnect/socket-transport/ws": "^7.5.11",
    "passport-did-auth/axios": "^0.34.0",
    "**/iam-client-lib/axios": "^0.34.0",
    "**/@ew-did-registry/did-ipfs-store/axios": "^0.34.0",
    "**/@ew-did-registry/revocation/axios": "^0.34.0",
    "**/@json-rpc-tools/provider/axios": "^0.34.0",
    "**/@walletconnect/utils/bn.js": "^4.12.3",
    "**/@ew-did-registry/keys/bn.js": "^5.2.3",
    "**/google-gax/protobufjs": "^7.6.3",
    "**/google-gax/protobufjs-cli": "^1.3.3",
    "**/google-gax/@grpc/grpc-js": "~1.9.16",
    "**/iam-client-lib/uuid": "^11.1.1",
    "**/solc/yargs/yargs-parser": "^5.0.1",
    "**/@typescript-eslint/typescript-estree/minimatch": "^9.0.7",
    "passport-did-auth/@ensdomains/ens-contracts": "0.0.22",
    "**/@types/rimraf/@types/glob": "^8.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "scarfSettings": {
    "enabled": false
  },
  "redisMemoryServer": {
    "disablePostinstall": "1"
  }
}
